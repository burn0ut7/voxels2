#ifndef VOXEL_TERRAIN_FIELD_FXC
#define VOXEL_TERRAIN_FIELD_FXC

// One canonical procedural field for all GPU terrain paths. Coordinates are
// canonical sample coordinates, so LOD only changes sampling density and never
// changes the terrain datum.
int VoxelTerrainHash( int x, int y, int seed )
{
	int value = seed + x * 374761393 + y * 668265263;
	value = (value ^ (value >> 13)) * 1274126177;
	return value ^ (value >> 16);
}

float2 VoxelTerrainGradient( int index )
{
	if ( index == 0 ) return float2( 1.0f, 0.0f );
	if ( index == 1 ) return float2( -1.0f, 0.0f );
	if ( index == 2 ) return float2( 0.0f, 1.0f );
	if ( index == 3 ) return float2( 0.0f, -1.0f );
	if ( index == 4 ) return float2( 0.70710677f, 0.70710677f );
	if ( index == 5 ) return float2( -0.70710677f, 0.70710677f );
	if ( index == 6 ) return float2( 0.70710677f, -0.70710677f );
	return float2( -0.70710677f, -0.70710677f );
}

float VoxelTerrainSimplexNoise( float2 point, int seed )
{
	const float skewFactor = 0.3660254038f;
	const float unskewFactor = 0.2113248654f;
	float skewed = (point.x + point.y) * skewFactor;
	int cellX = (int)floor( point.x + skewed );
	int cellY = (int)floor( point.y + skewed );
	float cellOffset = (cellX + cellY) * unskewFactor;
	float2 offset = point - (float2( cellX, cellY ) - cellOffset);
	int secondCornerX = offset.x > offset.y ? 1 : 0;
	int secondCornerY = offset.x > offset.y ? 0 : 1;
	float2 second = offset - float2( secondCornerX, secondCornerY ) + unskewFactor;
	float2 third = offset - 1.0f + 2.0f * unskewFactor;
	float value = 0.0f;
	float radius = 0.5f - dot( offset, offset );
	if ( radius > 0.0f ) value += radius * radius * radius * radius * dot( VoxelTerrainGradient( VoxelTerrainHash( cellX, cellY, seed ) & 7 ), offset );
	radius = 0.5f - dot( second, second );
	if ( radius > 0.0f ) value += radius * radius * radius * radius * dot( VoxelTerrainGradient( VoxelTerrainHash( cellX + secondCornerX, cellY + secondCornerY, seed ) & 7 ), second );
	radius = 0.5f - dot( third, third );
	if ( radius > 0.0f ) value += radius * radius * radius * radius * dot( VoxelTerrainGradient( VoxelTerrainHash( cellX + 1, cellY + 1, seed ) & 7 ), third );
	return 70.0f * value;
}

float EvaluateTerrainSurfaceHeight( float2 canonicalSample, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	return simplexBaseHeight + VoxelTerrainSimplexNoise( canonicalSample * simplexFrequency, simplexSeed ) * simplexAmplitude;
}

float EvaluateTerrainDensityFromSurfaceHeight( float canonicalSampleZ, float surfaceHeight, float sdfClampDistance )
{
	// Persistent GPU LODs interpolate this value across increasingly large
	// sample steps. Clamping to the LOD0 storage range makes both ends of a
	// coarse edge saturate at equal magnitude and moves its zero crossing toward
	// the edge midpoint (most visibly at LOD6). Keep the procedural field's true
	// signed distance; GPU buffers store floats and do not require CPU quantizing.
	return canonicalSampleZ - surfaceHeight;
}

float EvaluateTerrainDensity( float3 canonicalSample, float sdfClampDistance, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	float surfaceHeight = EvaluateTerrainSurfaceHeight( canonicalSample.xy, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	return EvaluateTerrainDensityFromSurfaceHeight( canonicalSample.z, surfaceHeight, sdfClampDistance );
}

struct VoxelEditOperation
{
	float4 PositionAndSmoothness;
	float4 Rotation;
	float4 SizeAndMaterial;
	uint Shape;
	uint Operation;
	uint WorldRevision;
	uint Reserved0;
	float4 BoundsMin;
};

StructuredBuffer<VoxelEditOperation> VoxelEditOperations < Attribute( "VoxelEditOperations" ); >;
StructuredBuffer<uint> VoxelEditIndices < Attribute( "VoxelEditIndices" ); >;

float3 VoxelRotateInverse( float3 point, float4 rotation )
{
	float3 inverseVector = -rotation.xyz;
	return point + 2.0f * cross( inverseVector, cross( inverseVector, point ) + rotation.w * point );
}

float VoxelEditShapeDistance( VoxelEditOperation edit, float3 canonicalSample )
{
	float3 point = VoxelRotateInverse( canonicalSample - edit.PositionAndSmoothness.xyz, edit.Rotation );
	if ( edit.Shape == 0 ) return length( point ) - edit.SizeAndMaterial.x;
	if ( edit.Shape == 1 )
	{
		point.z -= clamp( point.z, -edit.SizeAndMaterial.y, edit.SizeAndMaterial.y );
		return length( point ) - edit.SizeAndMaterial.x;
	}
	float3 delta = abs( point ) - edit.SizeAndMaterial.xyz;
	return length( max( delta, 0.0f ) ) + min( max( delta.x, max( delta.y, delta.z ) ), 0.0f );
}

float VoxelSmoothMinimum( float first, float second, float smoothing )
{
	if ( smoothing <= 0.0001f ) return min( first, second );
	float blend = saturate( 0.5f + 0.5f * (second - first) / smoothing );
	return lerp( second, first, blend ) - smoothing * blend * (1.0f - blend);
}

float ApplyTerrainEditShape( VoxelEditOperation edit, float3 canonicalSample, float density )
{
	float shape = VoxelEditShapeDistance( edit, canonicalSample );
	if ( edit.Operation == 0 ) return min( density, shape );
	if ( edit.Operation == 1 ) return max( density, -shape );
	if ( edit.Operation == 2 ) return VoxelSmoothMinimum( density, shape, edit.PositionAndSmoothness.w );
	if ( edit.Operation == 3 ) return -VoxelSmoothMinimum( -density, shape, edit.PositionAndSmoothness.w );
	return density;
}

float FinalizeEditedTerrainDensity( float density, float sdfClampDistance )
{
	return abs( density ) < 0.001f ? 0.001f : density;
}

float ApplyTerrainEdits( float3 canonicalSample, uint editOperationCount, float density, float sdfClampDistance )
{
	[loop] for ( uint index = 0; index < editOperationCount; index++ )
	{
		VoxelEditOperation edit = VoxelEditOperations[index];
		if ( edit.Operation == 4 ) continue;
		float boundsRadius = edit.BoundsMin.w;
		if ( any( abs( canonicalSample - edit.PositionAndSmoothness.xyz ) > boundsRadius ) ) continue;
		density = ApplyTerrainEditShape( edit, canonicalSample, density );
	}
	return FinalizeEditedTerrainDensity( density, sdfClampDistance );
}

float ApplyIndexedTerrainEdits( float3 canonicalSample, uint editIndexOffset, uint editIndexCount, float density, float sdfClampDistance )
{
	[loop] for ( uint localIndex = 0; localIndex < editIndexCount; localIndex++ )
	{
		VoxelEditOperation edit = VoxelEditOperations[VoxelEditIndices[editIndexOffset + localIndex]];
		float boundsRadius = edit.BoundsMin.w;
		if ( any( abs( canonicalSample - edit.PositionAndSmoothness.xyz ) > boundsRadius ) ) continue;
		density = ApplyTerrainEditShape( edit, canonicalSample, density );
	}
	return FinalizeEditedTerrainDensity( density, sdfClampDistance );
}

float EvaluateIndexedTerrainDensity( float3 canonicalSample, uint editIndexOffset, uint editIndexCount, float sdfClampDistance, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	float surfaceHeight = EvaluateTerrainSurfaceHeight( canonicalSample.xy, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	float density = EvaluateTerrainDensityFromSurfaceHeight( canonicalSample.z, surfaceHeight, sdfClampDistance );
	return ApplyIndexedTerrainEdits( canonicalSample, editIndexOffset, editIndexCount, density, sdfClampDistance );
}

float EvaluateEditedTerrainDensityFromSurfaceHeight( float3 canonicalSample, uint editOperationCount, float surfaceHeight, float sdfClampDistance )
{
	float density = EvaluateTerrainDensityFromSurfaceHeight( canonicalSample.z, surfaceHeight, sdfClampDistance );
	return ApplyTerrainEdits( canonicalSample, editOperationCount, density, sdfClampDistance );
}

float EvaluateEditedTerrainDensity( float3 canonicalSample, uint editOperationCount, float sdfClampDistance, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	float surfaceHeight = EvaluateTerrainSurfaceHeight( canonicalSample.xy, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	return EvaluateEditedTerrainDensityFromSurfaceHeight( canonicalSample, editOperationCount, surfaceHeight, sdfClampDistance );
}

float3 EvaluateEditedTerrainGradient( float3 canonicalSample, uint editOperationCount, float sampleStep, float sdfClampDistance, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	float3 delta = float3( sampleStep, 0.0f, 0.0f );
	float x = EvaluateEditedTerrainDensity( canonicalSample + delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateEditedTerrainDensity( canonicalSample - delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	delta = float3( 0.0f, sampleStep, 0.0f );
	float y = EvaluateEditedTerrainDensity( canonicalSample + delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateEditedTerrainDensity( canonicalSample - delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	delta = float3( 0.0f, 0.0f, sampleStep );
	float z = EvaluateEditedTerrainDensity( canonicalSample + delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateEditedTerrainDensity( canonicalSample - delta, editOperationCount, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	return float3( x, y, z );
}

float3 EvaluateTerrainGradient( float3 canonicalSample, float sampleStep, float sdfClampDistance, float simplexFrequency, float simplexAmplitude, float simplexBaseHeight, int simplexSeed )
{
	float3 delta = float3( sampleStep, 0.0f, 0.0f );
	float x = EvaluateTerrainDensity( canonicalSample + delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateTerrainDensity( canonicalSample - delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	delta = float3( 0.0f, sampleStep, 0.0f );
	float y = EvaluateTerrainDensity( canonicalSample + delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateTerrainDensity( canonicalSample - delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	delta = float3( 0.0f, 0.0f, sampleStep );
	float z = EvaluateTerrainDensity( canonicalSample + delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed ) - EvaluateTerrainDensity( canonicalSample - delta, sdfClampDistance, simplexFrequency, simplexAmplitude, simplexBaseHeight, simplexSeed );
	return float3( x, y, z );
}

#endif
