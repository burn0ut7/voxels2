#ifndef VOXEL_TRANSVOXEL_DEFORMATION_FXC
#define VOXEL_TRANSVOXEL_DEFORMATION_FXC

float TransitionSecondaryCoordinate( float coordinate, int chunkSize, bool negativeFace, bool positiveFace )
{
	if ( negativeFace && coordinate < 1.0f ) coordinate = 0.5f + coordinate * 0.5f;
	if ( positiveFace && coordinate > (float)(chunkSize - 1) ) coordinate = (float)chunkSize - 0.5f + (coordinate - (float)chunkSize) * 0.5f;
	return coordinate;
}

float3 TransitionSecondaryLocalPosition( float3 position, uint faceMask, int chunkSize )
{
	uint boundaryMask = 0u;
	if ( position.x < 1.0f ) boundaryMask |= 1u;
	if ( position.x > (float)(chunkSize - 1) ) boundaryMask |= 2u;
	if ( position.y < 1.0f ) boundaryMask |= 4u;
	if ( position.y > (float)(chunkSize - 1) ) boundaryMask |= 8u;
	if ( position.z < 1.0f ) boundaryMask |= 16u;
	if ( position.z > (float)(chunkSize - 1) ) boundaryMask |= 32u;
	if ( (faceMask & boundaryMask) != boundaryMask ) return position;

	position.x = TransitionSecondaryCoordinate( position.x, chunkSize, (faceMask & 1u) != 0, (faceMask & 2u) != 0 );
	position.y = TransitionSecondaryCoordinate( position.y, chunkSize, (faceMask & 4u) != 0, (faceMask & 8u) != 0 );
	position.z = TransitionSecondaryCoordinate( position.z, chunkSize, (faceMask & 16u) != 0, (faceMask & 32u) != 0 );
	return position;
}

float3 TransitionSecondaryCanonicalPosition( float3 position, float3 coarseOrigin, uint coarseStep, uint faceMask, int chunkSize )
{
	float3 local = (position - coarseOrigin) / (float)coarseStep;
	return coarseOrigin + TransitionSecondaryLocalPosition( local, faceMask, chunkSize ) * (float)coarseStep;
}

#endif
